@Article{Algina-Keselman-Penfield-2007,
  author = {James Algina and Harvey J. Keselman and Randall D. Penfield},
  date = {2007-04},
  journaltitle = {Educational and Psychological Measurement},
  title = {Confidence intervals for an effect size measure in multiple linear regression},
  doi = {10.1177/0013164406292030},
  issn = {1552-3888},
  number = {2},
  pages = {207--218},
  volume = {67},
  abstract = {The increase in the squared multiple correlation coefficient ($\Delta$R 2 ) associated with a variable in a regression equation is a commonly used measure of importance in regression analysis. The coverage probability that an asymptotic and percentile bootstrap confidence interval includes $\Delta$$\rho$ 2 was investigated. As expected, coverage probability for the asymptotic confidence interval was often inadequate (outside the interval .925 to .975 for a 95\% confidence interval), even when sample size was quite large (i.e., 200). However, adequate coverage probability for the confidence interval based on a bootstrap interval could typically be obtained with a sample size of 200 or less, and moreover, this accuracy was obtained with relatively small sample sizes (100 or less) with six or fewer predictors.},
  publisher = {SAGE Publications},
}
