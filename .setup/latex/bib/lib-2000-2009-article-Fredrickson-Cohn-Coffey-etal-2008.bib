@Article{Fredrickson-Cohn-Coffey-etal-2008,
  author       = {Fredrickson, Barbara L. and Cohn, Michael A. and Coffey, Kimberly A. and Pek, Jolynn and Finkel, Sandra M.},
  date         = {2008-11},
  journaltitle = {Journal of Personality and Social Psychology},
  title        = {Open hearts build lives: Positive emotions, induced through loving-kindness meditation, build consequential personal resources.},
  doi          = {10.1037/a0013262},
  issn         = {0022-3514},
  number       = {5},
  pages        = {1045--1062},
  volume       = {95},
  publisher    = {American Psychological Association (APA)},
  abstract     = {The broaden-and-build theory proposes that repeated experiences of positive emotion accumulate over time to build enduring personal resources. This hypothesis was tested in a field experiment involving 139 working adults, approximately half of whom were randomly assigned to begin loving-kindness meditation. Meditation practice produced gradual increases in daily positive emotions. Growth in positive emotions was subsequently associated with increases in a range of personal resources, including psychological, cognitive, social, and physical resources. Increases in these resources were in turn associated with greater life satisfaction and fewer depressive symptoms. The findings support the proposition that recurrent positive emotional experiences can produce lasting benefits by building resources that remain available beyond the transient emotional states that generated them.},
}
