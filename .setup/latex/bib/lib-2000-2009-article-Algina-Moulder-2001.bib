@Article{Algina-Moulder-2001,
  author = {James Algina and Bradley C. Moulder},
  date = {2001-08},
  journaltitle = {Educational and Psychological Measurement},
  title = {Sample sizes for confidence intervals on the increase in the squared multiple correlation coefficient},
  doi = {10.1177/00131640121971400},
  issn = {1552-3888},
  number = {4},
  pages = {633--649},
  volume = {61},
  abstract = {The increase in the squared multiple correlation coefficient ($\delta$ R 2 ) associated with a variable in a regression equation is a commonly used measure of importance in regression analysis. The probability that an asymptotic confidence interval will include $\delta$$\rho$ 2 was investigated. With sample sizes typically used in regression analyses, when $\delta$$\rho$ 2 = 0.00 and the confidence level is .95 or greater, the probability will be at least .999. For $\delta$$\rho$ 2 $\geq$ .01 and a confidence level of .95 or greater, the probability will be smaller than the nominal confidence level. For $\delta$$\rho$ 2 $\geq$ .05 and a confidence level of .95, tables are provided for the sample size necessary for the probability to be at least .925 and to be at least .94.},
  publisher = {SAGE Publications},
}
