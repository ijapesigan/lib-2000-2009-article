@Article{Hoeksma-Oosterlaan-Schipper-etal-2007,
  author = {Jan B. Hoeksma and Jaap Oosterlaan and Eline Schipper and Hans Koot},
  date = {2007-08},
  title = {Finding the attractor of anger: Bridging the gap between dynamic concepts and empirical data},
  journaltitle = {Emotion},
  volume = {7},
  number = {3},
  pages = {638--648},
  publisher = {American Psychological Association},
  abstract = {Although it accounts for the prototypical course of emotions, the attractor concept has hardly ever been used empirically. Authors applied Empirical Differential Equations (EDE) to frequent (hourly) anger ratings to find the attractor of anger. The attractor concept, its neurological basis, and EDE are explained. The attractor of anger follows an underdamped oscillator, and is affected by the capacity to inhibit prepotent responses. Anger accelerates less fast when inhibitory control increases. Results stress the internal dynamics of emotions, and help to bridge the gap between concepts from dynamic systems theory and empirical data.},
  keywords = {attractors, anger, emotional system, differential equations, modeling},
  doi = {10.1037/1528-3542.7.3.638},
  issn = {1528-3542},
}
