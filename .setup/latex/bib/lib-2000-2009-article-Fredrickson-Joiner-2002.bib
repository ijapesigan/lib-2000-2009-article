@Article{Fredrickson-Joiner-2002,
  author       = {Fredrickson, Barbara L. and Joiner, Thomas},
  date         = {2002-03},
  journaltitle = {Psychological Science},
  title        = {Positive emotions trigger upward spirals toward emotional well-being},
  abstract     = {The study tests the broaden-and-build prediction that positive emotions can initiate upward spirals toward greater emotional well-being. In a two-wave study of 138 college students, positive affect prospectively predicted improvements in broad-minded coping, while broad-minded coping predicted increases in positive affect. Mediational analyses further indicated reciprocal enhancement between positive affect and broad-minded coping, providing prospective evidence for an upward spiral process.},
  doi          = {10.1111/1467-9280.00431},
  issn         = {1467-9280},
  number       = {2},
  pages        = {172--175},
  volume       = {13},
  publisher    = {SAGE Publications},
}
