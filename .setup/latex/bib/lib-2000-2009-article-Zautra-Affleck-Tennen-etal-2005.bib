@Article{Zautra-Affleck-Tennen-etal-2005,
  author = {Alex J. Zautra and Glenn G. Affleck and Howard Tennen and John W. Reich and Mary C. Davis},
  date = {2005-09},
  journaltitle = {Journal of Personality},
  title = {Dynamic approaches to emotions and stress in everyday life: {Bolger} and {Zuckerman} reloaded with positive as well as negative affects},
  doi = {10.1111/j.0022-3506.2005.00357.x},
  issn = {1467-6494},
  number = {6},
  pages = {1511--1538},
  volume = {73},
  abstract = {A decade ago, {Bolger} and {Zuckerman} (1995) incorporated personality into the study of daily life events and psychological distress. Their approach put an entirely new cast on research and theorizing in this area. In their work, they focused on the predominantly negative personality trait of Neuroticism. In this article we extend their work to include theory and measurement of positive events and indicators of well-being. Integrating these research strands offers the possibility of a comprehensive yet highly sensitive and dynamic approach to the study of emotions, stress, and health in everyday life.},
  publisher = {Wiley},
}
